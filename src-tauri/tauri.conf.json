{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyricsStatus",
  "version": "1.1.1",
  "identifier": "com.lyricsstatus.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LyricsStatus",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#09090b",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "publisher": "selfsecured",
    "copyright": "MIT License. Created by selfsecured.",
    "category": "Music",
    "shortDescription": "Spotify lyrics as your Discord status",
    "longDescription": "Synced Spotify lyrics, right inside your Discord status. Follows the music you play through the Spotify account linked to Discord.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
